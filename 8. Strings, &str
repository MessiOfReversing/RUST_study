fn main() {
    // 1. &str 타입인 "David"를 수정 가능한 String 타입으로 변환합니다.
    let mut my_name = "David".to_string(); 
    
    // 2. String 타입이 되었기 때문에 뒤에 '!'를 붙이거나 이런저런 추가적인 크기 늘리기도 가능합니다.
    my_name.push('!'); 
    
    println!("My name is {}", my_name); // 출력: My name is David!
}



