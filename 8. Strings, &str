fn main() {
//String = Sized type
//str = dynamic type

    let my_name = "David"; // 이건 &str
    let other_name = String::from("David2");
    //growable + shrinkable
    let mut my_other_name = "David3".to_string();
    my_other_name.push('!');
    println!("{}", my_other_name);
}


