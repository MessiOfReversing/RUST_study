format!서식이 지정된 텍스트를 작성합니다.String
print!: 동일 format!, 그리고 텍스트가 콘솔(io::stdout)에 출력됩니다.
println!: 와 동일 print!, 그리고는 줄 바꿈 문자가 추가됩니다.
eprint!: 동일 print!, 그리고 텍스트가 표준 오류(io::stderr)로 출력됩니다.
eprintln!: 와 동일 eprint!, 그리고 줄 바꿈 문자가 추가됩니다.



fn main() {
    // In general, the `{}` will be automatically replaced with any
    // arguments. These will be stringified.
    println!("{} days", 31);

    // Positional arguments can be used. Specifying an integer inside `{}`
    // determines which additional argument will be replaced. Arguments start
    // at 0 immediately after the format string.
    println!("{0}, this is {1}. {1}, this is {0}", "Alice", "Bob");

    // As can named arguments.
    println!("{subject} {verb} {object}",
             object="the lazy dog",
             subject="the quick brown fox",
             verb="jumps over");

    // Different formatting can be invoked by specifying the format character
    // after a `:`. : 는 문자열을 어떻게 다룰건지를 결정함
    println!("Base 10:               {}",   69420); // 69420
    println!("Base 2 (binary):       {:b}", 69420); // 뒤의것 : b 니까 binary로 변환. 따라서 10000111100101100
    println!("Base 8 (octal):        {:o}", 69420); // 207454
    println!("Base 16 (hexadecimal): {:x}", 69420); // 10f2c

    // You can right-justify text with a specified width. This will
    // output "    1". (Four white spaces and a "1", for a total width of 5.)
    println!("{number:>5}", number=1); /* 오른쪽으로 5칸째에서 끝내게 해라.
    따라서 number가 123이었다면 공백 2칸이었을것. 문자열 길이보다 작게 요구하면 무시하고 처음부터 찍히게됨. */

    // You can pad numbers with extra zeroes,
    println!("{number:0>5}", number=1); // 00001
    // and left-adjust by flipping the sign. This will output "10000".
    println!("{number:0<5}", number=1); // 10000

    /* number=12 인 경우 (왼쪽 공백 1칸 + 숫자 12 + 오른쪽 공백 2칸)
    결과 : " 12  "
    */

    // You can use named arguments in the format specifier by appending a `$`.
    println!("{number:0>width$}", number=1, width=5);
    /* width로 너비를 동적으로 받기위해 $를 specifier처럼 사용함. */

    // Rust even checks to make sure the correct number of arguments are used.
    println!("My name is {0}, {1} {0}", "Bond", "James");
    

